{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Swiss Neo-Monolith Engineering System — single source of truth. All platform outputs are GENERATED from this file by scripts/build-tokens.mjs. Never edit generated files by hand.",
  "$meta": {
    "system": "Swiss Neo-Monolith",
    "code": "SNM",
    "version": "1.0.2",
    "updated": "2026-08-09",
    "author": "Okan Ozturk",
    "canvasBase": 4
  },

  "color": {
    "$description": "PRIMITIVES. Never reference these directly in product code — use semantic tokens below.",
    "bone": {
      "50":  { "$value": "#ffffff", "$description": "Paper — elevated surface, print stock" },
      "100": { "$value": "#f8f9f9" },
      "200": { "$value": "#f2f4f3", "$description": "SIGNATURE Titanium Bone Canvas" },
      "300": { "$value": "#e6e9e8" },
      "400": { "$value": "#d4d8d7" }
    },
    "obsidian": {
      "900": { "$value": "#121316", "$description": "SIGNATURE Obsidian" },
      "800": { "$value": "#1c1e22", "$description": "Raised surface on dark" },
      "700": { "$value": "#2a2d33" },
      "600": { "$value": "#3a3e46" }
    },
    "mint": {
      "300": { "$value": "#6ee7b7", "$description": "Dark-mode text-safe mint" },
      "500": { "$value": "#10b981", "$description": "SIGNATURE Swiss Neo Mint. 7.3:1 on obsidian. NOT text-safe on bone." },
      "600": { "$value": "#059669", "$description": "3.4:1 on bone — UI/graphic only, never body text" },
      "700": { "$value": "#047857", "$description": "4.9:1 on bone — the ONLY mint allowed for text on light" },
      "800": { "$value": "#065f46" }
    },
    "steel": {
      "200": { "$value": "#d1d5d3" },
      "400": { "$value": "#9ca3af", "$description": "Decorative / disabled only" },
      "500": { "$value": "#6b7280", "$description": "4.38:1 on bone — FAILS AA body text. Icons/borders only." },
      "600": { "$value": "#4b5563", "$description": "6.4:1 on bone — the muted text color" },
      "700": { "$value": "#374151" }
    },
    "signal": {
      "$description": "State colors. Desaturated to stay inside the industrial palette.",
      "danger":  { "$value": "#b91c1c", "$description": "5.9:1 on bone" },
      "dangerDark": { "$value": "#f87171", "$description": "on obsidian" },
      "warn":    { "$value": "#92400e", "$description": "6.5:1 on bone — amber darkened until it passes AA" },
      "warnDark":  { "$value": "#fbbf24" },
      "info":    { "$value": "#1d4ed8" },
      "infoDark":  { "$value": "#93c5fd" }
    }
  },

  "semantic": {
    "$description": "USE THESE. Each has a light and dark value.",
    "bg":            { "light": "{color.bone.200}",     "dark": "{color.obsidian.900}" },
    "bgRaised":      { "light": "{color.bone.50}",      "dark": "{color.obsidian.800}" },
    "bgSunken":      { "light": "{color.bone.300}",     "dark": "{color.obsidian.900}" },
    "bgInverse":     { "light": "{color.obsidian.900}", "dark": "{color.bone.200}" },
    "text":          { "light": "{color.obsidian.900}", "dark": "{color.bone.200}" },
    "textMuted":     { "light": "{color.steel.600}",    "dark": "{color.steel.400}" },
    "textInverse":   { "light": "{color.bone.50}",      "dark": "{color.obsidian.900}" },
    "textAccent":    { "light": "{color.mint.700}",     "dark": "{color.mint.300}" },
    "accent":        { "light": "{color.mint.500}",     "dark": "{color.mint.500}" },
    "accentUi":      { "light": "{color.mint.600}",     "dark": "{color.mint.500}" },
    "accentPress":   { "light": "{color.mint.600}",     "dark": "{color.mint.600}" },
    "border":        { "light": "rgba(18,19,22,0.15)",  "dark": "rgba(242,244,243,0.15)" },
    "borderStrong":  { "light": "{color.obsidian.900}", "dark": "{color.bone.200}" },
    "focus":         { "light": "{color.mint.700}",     "dark": "{color.mint.300}" },
    "overlay":       { "light": "rgba(18,19,22,0.60)",  "dark": "rgba(0,0,0,0.72)" },
    "danger":        { "light": "{color.signal.danger}","dark": "{color.signal.dangerDark}" },
    "warn":          { "light": "{color.signal.warn}",  "dark": "{color.signal.warnDark}" },
    "info":          { "light": "{color.signal.info}",  "dark": "{color.signal.infoDark}" }
  },

  "space": {
    "$description": "4px base. These are the ONLY permitted spacing values.",
    "0":  { "$value": "0px" },
    "1":  { "$value": "4px" },
    "2":  { "$value": "8px" },
    "3":  { "$value": "12px" },
    "4":  { "$value": "16px" },
    "5":  { "$value": "24px" },
    "6":  { "$value": "32px" },
    "7":  { "$value": "48px" },
    "8":  { "$value": "64px" },
    "9":  { "$value": "96px" },
    "10": { "$value": "128px" }
  },

  "size": {
    "radius":       { "$value": "0px", "$description": "IMMUTABLE. The only exception is a status pulse dot." },
    "borderHair":   { "$value": "1px" },
    "borderStruct": { "$value": "2px" },
    "borderHeavy":  { "$value": "3px" },
    "touchMin":     { "$value": "44px" },
    "headerH":      { "$value": "68px" },
    "headerHLg":    { "$value": "80px" },
    "contentMax":   { "$value": "1440px" },
    "proseMax":     { "$value": "68ch" }
  },

  "type": {
    "family": {
      "sans": { "$value": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif" },
      "mono": { "$value": "'JetBrains Mono', ui-monospace, SFMono-Regular, 'Cascadia Mono', Consolas, monospace" }
    },
    "scale": {
      "$description": "px / line-height / tracking(em)",
      "micro":   { "size": "11px", "leading": "14px", "tracking": "0.08em" },
      "xs":      { "size": "12px", "leading": "16px", "tracking": "0.04em" },
      "sm":      { "size": "14px", "leading": "20px", "tracking": "0em" },
      "base":    { "size": "16px", "leading": "26px", "tracking": "0em" },
      "lg":      { "size": "18px", "leading": "28px", "tracking": "-0.01em" },
      "xl":      { "size": "24px", "leading": "30px", "tracking": "-0.02em" },
      "2xl":     { "size": "32px", "leading": "36px", "tracking": "-0.025em" },
      "3xl":     { "size": "40px", "leading": "44px", "tracking": "-0.03em" },
      "4xl":     { "size": "56px", "leading": "56px", "tracking": "-0.035em" },
      "5xl":     { "size": "72px", "leading": "70px", "tracking": "-0.04em" }
    },
    "weight": {
      "regular":  { "$value": "400" },
      "medium":   { "$value": "500" },
      "bold":     { "$value": "700" },
      "extrabold":{ "$value": "800" }
    }
  },

  "motion": {
    "$description": "Mechanical, not organic. No spring, no bounce, no overshoot.",
    "duration": {
      "instant": { "$value": "0ms" },
      "fast":    { "$value": "120ms" },
      "base":    { "$value": "180ms" },
      "slow":    { "$value": "320ms" }
    },
    "ease": {
      "mech": { "$value": "cubic-bezier(0.2, 0, 0, 1)", "$description": "Default. Sharp attack, hard settle." },
      "out":  { "$value": "cubic-bezier(0.16, 1, 0.3, 1)" },
      "step": { "$value": "steps(4, end)", "$description": "Telemetry counters, loaders" }
    }
  },

  "elevation": {
    "$description": "NO blur. Hard-offset only — this is a structural system, not a material one.",
    "0": { "$value": "none" },
    "1": { "$value": "2px 2px 0 0 {semantic.borderStrong}" },
    "2": { "$value": "4px 4px 0 0 {semantic.borderStrong}" },
    "3": { "$value": "8px 8px 0 0 {semantic.borderStrong}" }
  },

  "print": {
    "$description": "Approximate CMYK conversions (naive, no ICC profile). VERIFY against a physical guide before any production print run.",
    "mint500": { "cmyk": "91 0 30 27", "pantoneApprox": "3395 C" },
    "obsidian900": { "cmyk": "75 65 60 90", "$description": "Rich black for large fills. Use K100 alone for body text." },
    "bone200": { "cmyk": "3 1 2 0", "$description": "Prefer uncoated natural stock over printing a flood tint." },
    "steel600": { "cmyk": "70 58 45 25" },
    "pageMargin": { "$value": "18mm" },
    "baselineGrid": { "$value": "4mm" },
    "bodySize": { "$value": "10pt" },
    "bodyLeading": { "$value": "14pt" }
  }
}
